# Web
# Use /api when deploying this monorepo as a single Vercel project.
NEXT_PUBLIC_API_URL=/api
# Dominio público real del sitio (SEO/metadata, JSON-LD, robots/sitemap, links públicos
# de invitaciones/listas de invitados). Sin esto, el código cae a un dominio *.vercel.app
# viejo hardcodeado como fallback — ver apps/web/src/app/layout.tsx, lib/local-seo.ts,
# lib/public-landing.ts.
NEXT_PUBLIC_SITE_URL=https://www.mymsalones.com.ar

# API
NODE_ENV=production
MONGODB_URI=
CORS_ORIGIN=https://www.mymsalones.com.ar
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Email notifications
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Uploads and generated PDFs
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Digital tickets payment provider. Keep every Mercado Pago credential only in
# environment variables (never in the database or the admin panel).
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ENVIRONMENT=test
TICKET_PAYMENT_PROVIDER=mock
# Vercel sends this value to daily fallback jobs. It must match
# MARKETING_CRON_SECRET while the Marketing fallback stays enabled, and it is
# also validated directly by /api/internal/calendar-tick for financial reminders.
CRON_SECRET=
# GitHub Actions invokes ticket automation every five minutes. Financial
# reminders use CRON_SECRET and FINANCIAL_REMINDERS_APP_BASE_URL.
TICKET_AUTOMATION_CRON_SECRET=

# Marketing & campaigns module — bulk email provider (mock by default; set to
# "resend" and provide RESEND_API_KEY to send real campaign emails). Separate
# from SMTP above, which stays reserved for one-off transactional emails.
MARKETING_EMAIL_PROVIDER=mock
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MARKETING_FROM_EMAIL=
MARKETING_FROM_NAME=M&M Eventos
MARKETING_REPLY_TO=
MARKETING_BATCH_SIZE=25
MARKETING_CRON_SECRET=

# Mobile staff app (attendance/clock-in) — bearer tokens issued by /api/mobile/auth,
# separate TTLs from the web's cookie-based tokens above (mobile sessions live longer).
MOBILE_ACCESS_TOKEN_TTL=30m
MOBILE_REFRESH_TOKEN_TTL=30d
MOBILE_OFFLINE_PUNCH_MAX_AGE_MINUTES=720
MOBILE_DEEP_LINK_SCHEME=mymeventos
ATTENDANCE_DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires
ATTENDANCE_DEFAULT_LOCATION_ACCURACY_METERS=50
ATTENDANCE_DEFAULT_GEOFENCE_RADIUS_METERS=150
