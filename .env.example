# Web
# Use /api when deploying this monorepo as a single Vercel project.
NEXT_PUBLIC_API_URL=/api

# API
NODE_ENV=production
MONGODB_URI=
CORS_ORIGIN=https://your-vercel-domain.vercel.app
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Email notifications
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Uploads and generated PDFs
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Digital tickets payment provider. Keep every Mercado Pago credential only in
# environment variables (never in the database or the admin panel).
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_ENVIRONMENT=test
TICKET_PAYMENT_PROVIDER=mock

# Optional bootstrap/admin scripts
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
RESET_ADMIN_USERNAME=admin
RESET_ADMIN_PASSWORD=
