{
  "name": "@mym/api",
  "version": "1.0.0",
  "description": "Backend API for M&M Eventos",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "predev": "node scripts/free-api-port.cjs",
    "dev": "nodemon --exec ts-node --files src/index.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "ts-node src/db/seed.ts",
    "seed:digital-tickets": "ts-node src/scripts/seedDigitalTickets.ts",
    "seed:marketing-templates": "ts-node src/scripts/seedMarketingTemplates.ts",
    "seed:mobile-attendance": "ts-node src/scripts/seedMobileAttendance.ts",
    "clean:digital-tickets-demo": "ts-node src/scripts/cleanDigitalTicketsDemo.ts",
    "seed:salon-stock": "ts-node src/scripts/updateSalonStock.ts",
    "reset:admin-password": "ts-node src/scripts/resetAdminPassword.ts",
    "update:la-plata-packages": "ts-node src/scripts/updateLaPlataPackages.ts",
    "migrate:package-template-names": "ts-node src/scripts/removePackageTemplateNameUniqueIndex.ts",
    "migrate:invitation-event-index": "ts-node src/scripts/removeLegacyInvitationEventIdIndex.ts",
    "migrate:remove-ticket-payment-credentials": "ts-node src/scripts/removeTicketPaymentCredentials.ts",
    "import:promo-infantil-packages": "ts-node src/scripts/importPromoInfantilPackages.ts",
    "import:san-carlos-packages": "ts-node src/scripts/importSanCarlosPackages.ts",
    "import:la-plata-premium-packages": "ts-node src/scripts/importLaPlataPremiumPackages.ts"
  },
  "dependencies": {
    "@mym/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.2.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.11",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.3",
    "sanitize-html": "^2.17.6",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.11.20",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
