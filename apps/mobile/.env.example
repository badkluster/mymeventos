# Expo inlines EXPO_PUBLIC_* variables into the installed app. Never store secrets here.
# Authorization must continue to happen through the backend and bearer tokens.

# Local development only. Copy this file to .env.local.
# Android Emulator reaches the host computer through 10.0.2.2.
# A physical phone must use the computer's LAN IP, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3001/api
# EXPO_PUBLIC_WEB_URL=http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api
EXPO_PUBLIC_WEB_URL=http://10.0.2.2:3000

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Must match `scheme` in app.json and MOBILE_DEEP_LINK_SCHEME in the API.
EXPO_PUBLIC_DEEP_LINK_SCHEME=mymeventos

# Cloud APK/AAB builds use https://www.mymsalones.com.ar by default for public legal links.
# EXPO_PUBLIC_WEB_URL can override that value when a different public website is required.
# Their backend URL is configured once in the `build.base.env.EXPO_PUBLIC_API_URL` field of eas.json.
