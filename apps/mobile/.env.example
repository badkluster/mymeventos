# Expo inlines any EXPO_PUBLIC_* variable into the JS bundle at build time — never put
# secrets here (they would ship inside the installed app). This app has no secrets: all
# authorization happens against the backend via username/password + bearer tokens.

# Base URL of the API. Android Emulator uses 10.0.2.2 to reach the PC; a physical
# device on the same network must use the PC's LAN IP (e.g. http://192.168.1.20:3001/api).
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api

# development | preview | production — only used to label the environment in-app
# (e.g. a banner on non-production builds) and in error reports.
EXPO_PUBLIC_APP_ENV=development

# Must match the `scheme` in app.json and MOBILE_DEEP_LINK_SCHEME on the API, used for
# password-reset deep links (mymeventos://reset-password?token=...).
EXPO_PUBLIC_DEEP_LINK_SCHEME=mymeventos
