{
  "name": "@mym/mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eas:init": "npx --yes eas-cli@21.3.0 init",
    "eas:configure": "npx --yes eas-cli@21.3.0 build:configure",
    "build": "npx --yes eas-cli@21.3.0 build --platform android --profile apk",
    "build:apk": "npx --yes eas-cli@21.3.0 build --platform android --profile apk",
    "build:preview": "npx --yes eas-cli@21.3.0 build --platform android --profile preview",
    "build:android:store": "npx --yes eas-cli@21.3.0 build --platform android --profile production",
    "build:ios:store": "npx --yes eas-cli@21.3.0 build --platform ios --profile production",
    "build:stores": "npx --yes eas-cli@21.3.0 build --platform all --profile production",
    "submit:android": "npx --yes eas-cli@21.3.0 submit --platform android --profile production",
    "submit:ios": "npx --yes eas-cli@21.3.0 submit --platform ios --profile production",
    "postinstall": "cd ../.. && pnpm --filter @mym/shared build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@mym/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "expo": "~57.0.8",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-local-authentication": "~57.0.2",
    "expo-location": "~57.0.6",
    "expo-network": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^12.4.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.17",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "private": true
}
