{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "corepack enable && corepack prepare pnpm@10.24.0 --activate && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @mym/api build && pnpm --filter @mym/web build",
  "devCommand": "pnpm dev",
  "outputDirectory": "apps/web/.next",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30,
      "includeFiles": "apps/web/public/brand/mym-logo-dark-on-light.jpg"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
